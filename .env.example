# Copy to .env.local and adjust for your setup.
# run-local.sh sources this automatically.

# ── Core service URLs (consumed by CLI and agents) ────────────────────────────
REGISTRY_URL=http://127.0.0.1:9000
SCHEDULER_URL=http://127.0.0.1:9001
OBJECT_STORE_URL=http://127.0.0.1:7001

# ── Object store (consumed by the object-store process itself) ────────────────
OBJECT_STORE_ADDR=127.0.0.1:7001
STORAGE_ROOT=data
METADATA_DB=metadata.db

# ── Auth (optional — same key on all services + CLI) ─────────────────────────
# TINYAWS_API_KEY=dev-secret

# ── Agent ─────────────────────────────────────────────────────────────────────
# IP that the load balancer and other services use to reach THIS agent machine.
# Set to the machine's LAN IP on multi-machine clusters.
# AGENT_ADVERTISE_ADDR=192.168.1.10

# Port the agent HTTP server listens on (health/info endpoints).
# AGENT_ADDR=0.0.0.0:8080

# Set to 1 to isolate each service job in its own pid+mount namespace (Linux, requires root).
# TINYAWS_ISOLATE=0

# ── Scheduler ─────────────────────────────────────────────────────────────────
# Seconds a job can run before being marked failed. Default: 3600 (1 hour).
# JOB_TIMEOUT_SECS=3600

# Max concurrent jobs per compute node. Default: 1.
# MAX_JOBS_PER_NODE=1

# Point scheduler at SQS to accept job submissions via queue.
# SQS_URL=http://127.0.0.1:9003

# Point scheduler/registry at SNS to fire events on job done / instance launch.
# SNS_URL=http://127.0.0.1:9004

# ── Optional service addresses (defaults shown) ───────────────────────────────
# CONTROLLER_ADDR=:9002
# SQS_ADDR=:9003
# SNS_ADDR=:9004
# NETWORKING_ADDR=:9005
# METADATA_ADDR=:9006
# LAMBDA_ADDR=:9007
# LB_ADDR=:8088

# ── Networking / metadata (consumed by CLI and metadata aggregator) ────────────
# NETWORKING_URL=http://127.0.0.1:9005
# LAMBDA_URL=http://127.0.0.1:9007
# LB_URL=http://127.0.0.1:8088

# ── API gateway (point CLI here to use a single URL for everything) ────────────
# TINYAWS_API_URL=http://127.0.0.1:8000

# ── Scheduler DB path ─────────────────────────────────────────────────────────
# SCHEDULER_DB=scheduler.db
